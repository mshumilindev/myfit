{
  "name": "spotter",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client",
    "desktop"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "storybook": "npm run storybook -w client",
    "build-storybook": "npm run build-storybook -w client",
    "audit:stories": "node scripts/story-audit.mjs",
    "audit:weekdays": "node scripts/weekday-row-audit.mjs",
    "audit:chat": "node scripts/chat-layout-audit.mjs",
    "audit:hero": "node scripts/hero-audit.mjs",
    "audit:theme-swap": "node scripts/theme-swap-audit.mjs",
    "audit:pixels": "node scripts/pixel-diff.mjs",
    "theme:new": "node scripts/theme-new.mjs",
    "dev": "npm run dev -w server & npm run dev -w client & wait",
    "build": "npm run build -w server && npm run build -w client && npm run build -w desktop",
    "start": "npm run start -w server",
    "tray": "npm run start -w desktop",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client && npm run typecheck -w desktop",
    "lint": "eslint .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "exercise-images": "tsx scripts/exercise-images/cli.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:coverage && npm run test:e2e",
    "test:unit": "vitest run",
    "test:changed": "vitest run --changed",
    "check:fast": "node scripts/check-fast.mjs",
    "metrics": "node scripts/code-metrics.mjs",
    "test:coach-server": "vitest run tests/coach-server",
    "test:rules": "firebase emulators:exec --only firestore --project demo-spotter \"vitest run --config vitest.rules.config.ts\"",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --project=mobile-chromium",
    "e2e:coach": "E2E_COACH=1 playwright test --project=coach-390 --project=coach-768 --project=coach-1024 --project=coach-1440",
    "e2e:coach:fresh": "rm -rf client/dist-e2e && npm run e2e:coach",
    "deadcode": "node scripts/unused-exports.mjs",
    "tutorial:mobile": "node scripts/record-mobile-video.mjs",
    "tutorial:mobile:first-workout": "node scripts/record-mobile-video.mjs --scenario first-workout",
    "verify:pwa": "npm run build -w client && node scripts/verify-tabbar-safe-area.mjs && node scripts/verify-pwa-autoupdate.mjs",
    "verify:ui": "npm run build -w client && node scripts/verify-pinned-headers.mjs && node scripts/verify-empty-exercise-card.mjs",
    "prepare": "node ./scripts/install-git-hooks.mjs",
    "coverage:guard": "node scripts/check-coverage-thresholds.mjs",
    "lint:css": "node scripts/stylelint-ratchet.mjs",
    "deps:check": "depcruise client/src --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json",
    "deps:baseline": "depcruise client/src --config .dependency-cruiser.cjs --output-type baseline > .dependency-cruiser-known-violations.json",
    "metrics:stability": "node scripts/stability-metrics.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "prettier": "^3.8.3",
    "sharp": "^0.35.4",
    "stylelint": "^16.26.1",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
