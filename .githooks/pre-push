#!/usr/bin/env bash
# Pre-push hook для gym-tracker (адаптовано з b2b-portal-ui).
#
# Прогонить ESLint + Prettier + tsc --noEmit (всі воркспейси) + coverage-тести + validate-sql,
# щоб стильові/типові регресії не їхали в remote. Авто-фіксить що може, і
# перериває push, якщо авто-фіксери створили диф — закоміть і пушни знову.
#
# Вмикається 'npm install' (lifecycle-скрипт 'prepare').
# Вимкнути вручну: git config --unset core.hooksPath
# Обхід на один push: git push --no-verify

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ ! -d node_modules ]; then
  echo "[pre-push] node_modules відсутній. Запусти: npm install"
  exit 1
fi

cache_dir="$repo_root/node_modules/.cache"
mkdir -p "$cache_dir"

# 1) Авто-фіксери (послідовно: обидва пишуть у ті самі файли). Кеш за вмістом: повторний push
#    чіпає лише змінені файли. eslint --fix сам падає на невиправних помилках, тож окремий
#    повторний `eslint .` не потрібен; prettier --write + перевірка diff нижче замінює format:check.
echo "[pre-push] eslint --fix"
npx --no-install eslint . --fix --cache --cache-strategy content --cache-location "$cache_dir/eslint/"
echo "[pre-push] prettier --write"
npx --no-install prettier --write --log-level warn --cache --cache-strategy content \
  --cache-location "$cache_dir/prettier/.cache" .

if ! git diff --quiet HEAD --; then
  echo ""
  echo "[pre-push] робоче дерево відрізняється від HEAD після авто-форматерів:"
  echo ""
  git --no-pager diff --stat HEAD --
  echo ""
  echo "[pre-push] ПЕРЕРИВАЮ push. Ймовірні причини:"
  echo "[pre-push]   (а) авто-форматери щойно щось виправили — закоміть диф і пушни знову, або"
  echo "[pre-push]   (б) є незв'язаний WIP — застешь або закоміть його."
  echo "[pre-push] Обхід на один push: git push --no-verify"
  exit 1
fi

# 2) Незалежні перевірки паралельно; кожна пише у свій лог, вивід друкується по порядку.
#    tsc інкрементальний (tsbuildinfo у node_modules/.cache): тепла перевірка — секунди.
log_dir=$(mktemp -d)
trap 'rm -rf "$log_dir"' EXIT
names=(typecheck-client typecheck-server typecheck-desktop test-coverage validate-sql)
cmds=(
  "npm run --silent typecheck -w client -- --incremental --tsBuildInfoFile $cache_dir/tsc-client.tsbuildinfo"
  "npm run --silent typecheck -w server -- --incremental --tsBuildInfoFile $cache_dir/tsc-server.tsbuildinfo"
  "npm run --silent typecheck -w desktop -- --incremental --tsBuildInfoFile $cache_dir/tsc-desktop.tsbuildinfo"
  "npm run --silent test:coverage"
  "node scripts/validate-sql.mjs"
)
pids=()
for i in "${!names[@]}"; do
  echo "[pre-push] ${names[$i]} (паралельно)"
  bash -c "${cmds[$i]}" >"$log_dir/${names[$i]}.log" 2>&1 &
  pids+=($!)
done
failed=0
for i in "${!names[@]}"; do
  if wait "${pids[$i]}"; then
    echo "[pre-push] ✓ ${names[$i]}"
  else
    failed=1
    echo ""
    echo "[pre-push] ✗ ${names[$i]} — вивід:"
    cat "$log_dir/${names[$i]}.log"
  fi
done
if [ "$failed" -ne 0 ]; then
  echo ""
  echo "[pre-push] ПЕРЕРИВАЮ push: є червоні перевірки (див. вище)."
  exit 1
fi

echo "[pre-push] OK"
