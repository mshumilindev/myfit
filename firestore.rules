rules_version = '2';

// Spotter — Firestore security rules.
//
// Auth is bridged from the app's own bcrypt credential store via Firebase
// custom tokens (see functions/src/auth.ts). Each token carries a `role` claim
// ('member' | 'trainer' | 'admin'), so rules can gate by role. All privileged
// / cross-user work (admin, trainer, invites, role/assignment changes, audited
// reads) runs in Cloud Functions with the Admin SDK, which bypasses these rules
// — so the client-facing rules below only ever need to grant a user access to
// their OWN data plus the shared catalog.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function role() {
      return isSignedIn() && 'role' in request.auth.token
        ? request.auth.token.role
        : 'member';
    }
    // The role claim is baked into the custom token and can be stale (demotion, suspension): every coach/admin
    // privilege below ALSO requires the live users/{uid} document to agree (one cached get per request). The functions
    // that change a role or suspend an account additionally revoke refresh tokens and end the relationships
    // (plan-security B-02), so a stale claim reaches nothing in the meantime.
    function liveUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function notSuspended() {
      return liveUser().get('status', 'active') != 'suspended';
    }
    function isAdmin() {
      return role() == 'admin' && liveUser().get('role', 'member') == 'admin' && notSuspended();
    }
    function isTrainerOrAdmin() {
      return (role() == 'trainer' || role() == 'admin')
        && liveUser().get('role', 'member') in ['trainer', 'admin']
        && notSuspended();
    }
    // --- Team helpers (SPO-196, ADR 005) ---------------------------------------------------------
    // A manager is NOT a coach: isCoachRole()/isTrainerOrAdmin() stay false for them. Team membership lives in
    // teams/{teamId}/members/{uid} (functions only); teamId is the owner trainer's uid and users/{uid}.teamId points
    // a member trainer at it (absent = the trainer owns their own team). Like every role privilege, the manager role
    // also needs the LIVE users/{uid} document to agree with the claim (stale-claim guard).
    function isManager() {
      return role() == 'manager'
        && liveUser().get('role', 'member') == 'manager'
        && notSuspended();
    }
    function teamOf(trainerUid) {
      return get(/databases/$(database)/documents/users/$(trainerUid)).data.get('teamId', trainerUid);
    }
    function teamMember(teamId, memberUid) {
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(memberUid)).data;
    }
    function isActiveManagerIn(teamId, memberUid) {
      return exists(/databases/$(database)/documents/teams/$(teamId)/members/$(memberUid))
        && teamMember(teamId, memberUid).get('role', '') == 'manager'
        && teamMember(teamId, memberUid).get('status', '') == 'active';
    }
    function isActiveMemberOf(teamId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && teamMember(teamId, request.auth.uid).get('status', '') == 'active';
    }
    // The signed-in manager belongs to the team of the given trainer.
    function isTeamManagerOfTrainer(trainerUid) {
      return isSignedIn() && isManager() && isActiveManagerIn(teamOf(trainerUid), request.auth.uid);
    }
    // The manager sees a client only while the client's coaching relationship is active (same switch as the trainer).
    function isTeamManagerOf(clientId) {
      return isSignedIn()
        && coachingOf(clientId).status == 'active'
        && isTeamManagerOfTrainer(coachingOf(clientId).trainerId);
    }
    // --- Coaching helpers (conversation = one client + one trainer; cid is an OPAQUE id,
    // so the parties come from the conversation document, never from the path) ----------
    function coachingOf(clientId) {
      return get(/databases/$(database)/documents/coaching/$(clientId)).data;
    }
    // Coach access is a role (trainer OR admin: an admin has the same rights as a trainer, for
    // the clients they coach themselves) AND an active relationship. Consent applies identically.
    function isCoachRole() {
      return isTrainerOrAdmin();
    }
    // The coach reads/writes a client's coaching data only while the relationship is active.
    function isActiveCoachOf(clientId) {
      return isSignedIn()
        && isCoachRole()
        && coachingOf(clientId).trainerId == request.auth.uid
        && coachingOf(clientId).status == 'active';
    }
    function convOf(cid) {
      return get(/databases/$(database)/documents/conversations/$(cid)).data;
    }
    // d = conversation DOCUMENT data (resource.data). Query-safe: no get() on document-derived
    // paths, so `where('trainerId','==',uid).where('active','==',true)` is a legal list query.
    // `active` is maintained by functions in the same transaction as coaching.status.
    function inConvData(d) {
      return isSignedIn() && (
        request.auth.uid == d.clientId
        || (request.auth.uid == d.trainerId && isCoachRole() && d.get('active', false) == true)
      );
    }
    // Sub-collections (cid known from the path): the AUTHORITATIVE coaching.status decides.
    function inConv(cid) {
      return isSignedIn() && (
        request.auth.uid == convOf(cid).clientId
        || (request.auth.uid == convOf(cid).trainerId && isActiveCoachOf(convOf(cid).clientId)) /* isActiveCoachOf includes isCoachRole() */
      );
    }
    // Writes need an ACTIVE relationship for both sides.
    function activeConv(cid) {
      return inConv(cid)
        && coachingOf(convOf(cid).clientId).status == 'active'
        && coachingOf(convOf(cid).clientId).trainerId == convOf(cid).trainerId;
    }
    function isConvTrainer(cid) {
      return isCoachRole() && request.auth.uid == convOf(cid).trainerId;
    }
    // A document must use the epoch of the published chat key. The client may write epoch 1
    // before its first wrap is published; the trainer never can (no key, no write).
    function epochOk(cid, e) {
      return convOf(cid).get('keyEpoch', 0) == e
        || (convOf(cid).get('keyEpoch', 0) == 0 && request.auth.uid == convOf(cid).clientId && e == 1);
    }
    // Envelope sealed with a conversation sub-key: { v, iv, ct } only (no salt), 96-bit IV,
    // ciphertext padded to 64-byte buckets, capped at ~8 KB of plaintext (<11000 base64 chars).
    function sealedCk(d) {
      return d.keys().hasAll(['enc', 'keyEpoch'])
        && d.enc is map
        && d.enc.keys().hasOnly(['v', 'iv', 'ct'])
        && d.enc.v == 1
        && d.enc.iv is string && d.enc.iv.size() == 16
        && d.enc.ct is string && d.enc.ct.size() >= 100 && d.enc.ct.size() < 11000
        && d.keyEpoch is int && d.keyEpoch >= 1 && d.keyEpoch <= 10000;
    }
    // Plan documents hold a whole program (plan-backend R-BE-DB-4: < 200 KB). The client seals at most 180000
    // bytes (PLAN_MAX_BYTES in newCollections.ts) = 240000 base64 characters plus padding.
    function sealedCkPlan(d) {
      return d.keys().hasAll(['enc', 'keyEpoch'])
        && d.enc is map
        && d.enc.keys().hasOnly(['v', 'iv', 'ct'])
        && d.enc.v == 1
        && d.enc.iv is string && d.enc.iv.size() == 16
        && d.enc.ct is string && d.enc.ct.size() >= 100 && d.enc.ct.size() < 250000
        && d.keyEpoch is int && d.keyEpoch >= 1 && d.keyEpoch <= 10000;
    }
    // Schedule documents: SCHEDULE_MAX_BYTES (120000) of plaintext = 160000 base64 characters plus padding and tag.
    function sealedCkSchedule(d) {
      return d.keys().hasAll(['enc', 'keyEpoch'])
        && d.enc is map
        && d.enc.keys().hasOnly(['v', 'iv', 'ct'])
        && d.enc.v == 1
        && d.enc.iv is string && d.enc.iv.size() == 16
        && d.enc.ct is string && d.enc.ct.size() >= 100 && d.enc.ct.size() < 165000
        && d.keyEpoch is int && d.keyEpoch >= 1 && d.keyEpoch <= 10000;
    }
    // conversations/{cid}.ck: the conversation key wrapped for the trainer public key.
    function validCk(ck) {
      return ck is map
        && ck.keys().hasOnly(['v', 'epoch', 'epk', 'iv', 'ct', 'fp'])
        && ck.v == 1 && ck.epoch is int && ck.epoch >= 1
        && ck.epk is map && ck.epk.keys().hasOnly(['kty', 'crv', 'x', 'y', 'ext', 'key_ops'])
        && ck.iv is string && ck.iv.size() == 16
        && ck.ct is string && ck.ct.size() == 64
        && ck.fp is string && ck.fp.size() == 16;
    }
    // A published wrap may (a) start the next epoch (one step, or up to the relationship's epoch + 1 after an end), or
    // (b) re-wrap the SAME epoch for a different trainer key (different fingerprint, e.g. after a key change). The same
    // epoch with the same fingerprint cannot be replaced, and an epoch cannot be made up far ahead (plan-security B-20).
    function ckStep(conv, ck) {
      return ck.epoch == conv.get('keyEpoch', 0) + 1
        || (ck.epoch > conv.get('keyEpoch', 0)
            && ck.epoch <= coachingOf(conv.clientId).get('keyEpoch', 0) + 1)
        || (ck.epoch == conv.get('keyEpoch', 0)
            && conv.get('ck', null) != null
            && ck.fp != conv.ck.fp);
    }
    // One side moves ONLY its own entry in a pointer map, and only forward.
    function ownPointerOk(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data[field][request.auth.uid] is int
            && request.resource.data[field][request.auth.uid] >= resource.data[field].get(request.auth.uid, 0));
    }
    // `clearedBefore` is the user's OWN view marker: it may also move back (Undo of "Clear chat").
    function ownMarkerOk(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data[field][request.auth.uid] is int
            && request.resource.data[field][request.auth.uid] >= 0);
    }
    function validDel(d) {
      return d is map && d.keys().hasOnly(['state', 'at']) && d.state == 'pending' && d.at is int;
    }
    // Envelope sealed with the OWNER'S vault key (DEK): { v, salt, iv, ct } only, 96-bit IV (16 base64 chars), bounded.
    // Every trainer-private or client-private document below must carry exactly this; plaintext siblings are refused.
    function dekEnc(d, maxCt) {
      return d.keys().hasAll(['enc'])
        && d.enc is map
        && d.enc.keys().hasOnly(['v', 'salt', 'iv', 'ct'])
        && d.enc.v == 1
        && d.enc.salt is string && d.enc.salt.size() <= 64
        && d.enc.iv is string && d.enc.iv.size() == 16
        && d.enc.ct is string && d.enc.ct.size() >= 24 && d.enc.ct.size() < maxCt;
    }
    // programs/prg-{clientUid}-{n} are the runnable programs a trainer writes for ONE client: only the active coach of
    // THAT client may create, change or delete one (a squatted or orphaned id cannot block Send or outlive the link).
    function prgClient(pid) {
      let p = pid.split('-');
      return p.size() == 3 ? p[1]
        : p.size() == 4 ? p[1] + '-' + p[2]
        : p.size() == 5 ? p[1] + '-' + p[2] + '-' + p[3]
        : p.size() == 6 ? p[1] + '-' + p[2] + '-' + p[3] + '-' + p[4]
        : p.size() == 7 ? p[1] + '-' + p[2] + '-' + p[3] + '-' + p[4] + '-' + p[5]
        : p.size() == 8 ? p[1] + '-' + p[2] + '-' + p[3] + '-' + p[4] + '-' + p[5] + '-' + p[6]
        : '';
    }
    function prgOk(pid) {
      return !pid.matches('prg-.*')
        || (prgClient(pid) != '' && isActiveCoachOf(prgClient(pid)));
    }
    // Live presence: the original five fields stay valid for current clients; the
    // sealed extension (name/gym/counts inside `enc`, sub-key "live") is additive.
    function validLiveSession(athleteId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'trainerId', 'startedAt', 'updatedAt', 'finishedAt', 'expireAt', 'keyEpoch', 'enc'])
        && d.keys().hasAll(['id', 'trainerId', 'startedAt', 'updatedAt'])
        && d.id == athleteId
        && d.trainerId is string
        && d.trainerId == get(/databases/$(database)/documents/users/$(athleteId)).data.trainerId
        && d.startedAt is int
        && d.updatedAt is int
        && (!('finishedAt' in d) || d.finishedAt is int)
        && (!('expireAt' in d) || d.expireAt is int)
        && (!('enc' in d) || sealedCk(d));
    }

    // --- Users: public-ish profile document ---------------------------------
    // Sensitive credentials (password hash) live in /credentials, never here.
    match /users/{userId} {
      // A signed-in user reads their own profile. Cross-user profile reads for
      // admins/trainers go through Cloud Functions (Admin SDK), not the client.
      allow get: if isSelf(userId);
      allow list: if false;
      // Accounts are created only by the auth functions.
      allow create, delete: if false;
      // Self may edit only display-name and avatar fields. Username (uniqueness)
      // and role/status/trainer (privilege) change via functions.
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'avatarExt', 'updatedAt']);

      // Tracker data — a workout is one document with nested exercises/sets.
      match /workouts/{workoutId} {
        allow read, write: if isSelf(userId);
      }
      match /gyms/{gymId} {
        allow read, write: if isSelf(userId);
      }
      // Rest / recovery / vacation periods — own read/write only.
      match /restPeriods/{periodId} {
        allow read, write: if isSelf(userId);
      }
      // Injuries & rehab plans — own read/write only.
      match /injuries/{injuryId} {
        allow read, write: if isSelf(userId);
      }
      // Chronic health conditions — sealed in the vault; own read/write only.
      match /conditions/{conditionId} {
        allow read, write: if isSelf(userId);
      }
      // Cardio / recovery activities — live timers stay local until finish, then
      // the finished activity is written here by the owner.
      match /activities/{activityId} {
        allow read, write: if isSelf(userId);
      }
      // Sleep nights — live and finished. Own read/write; scheduled functions
      // (auto-start / auto-end) write via the Admin SDK, bypassing these rules.
      match /sleeps/{sleepId} {
        allow read, write: if isSelf(userId);
      }
      // Body metrics (weigh-ins, height, composition) AND Spotter Nutrition,
      // which stores its data in singleton meta/* docs (nutritionLog,
      // nutritionFoods, nutritionGoal, nutritionProfile) under the same account
      // — all covered here. Own read/write only; admin/trainer cross-user reads
      // go through functions (Admin SDK).
      match /meta/{docId} {
        allow read: if isSelf(userId);
        // the sealed coaching documents have their own shape rules below
        allow write: if isSelf(userId) && !(docId in ['chatKeys', 'signalState', 'selfCoach', 'calendarSettings']);
      }
      // Chat key store: every conversation key of this user, sealed under their DEK (written with encryptJson).
      match /meta/chatKeys {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly(['v', 'enc'])
          && request.resource.data.keys().hasAll(['v', 'enc'])
          && request.resource.data.v == 1
          && dekEnc(request.resource.data, 200000);
        allow delete: if isSelf(userId);
      }
      match /meta/signalState {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly(['updatedAt', 'enc'])
          && request.resource.data.updatedAt is int
          && dekEnc(request.resource.data, 300000);
        allow delete: if isSelf(userId);
      }
      match /meta/selfCoach {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly(['updatedAt', 'enc'])
          && request.resource.data.updatedAt is int
          && dekEnc(request.resource.data, 100000);
        allow delete: if isSelf(userId);
      }
      // The trainer's calendar settings (working hours, gyms, range), sealed under their DEK.
      match /meta/calendarSettings {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly(['updatedAt', 'enc'])
          && request.resource.data.updatedAt is int
          && dekEnc(request.resource.data, 20000);
        allow delete: if isSelf(userId);
      }
      match /pings/{pingId} {
        allow read, write: if isSelf(userId);
      }
      // Vault grants: the athlete's data key, encrypted for one coach (ciphertext only).
      // The coach receives it through a function; the server never holds a readable key.
      match /grants/{coachId} {
        allow read, write: if isSelf(userId);
      }
      // Web push: this user's device tokens and the messages their client
      // planned (Cloud Functions deliver both with the admin SDK).
      match /push/{deviceId} {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.token is string
          && request.resource.data.token.size() < 4096;
      }
      match /outbox/{messageId} {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.dueAt is number
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 400;
      }
      match /reminderDismissals/{dismissId} {
        allow read, write: if isSelf(userId);
      }

      // Notices: read your own; mark-as-read is the only client write.
      match /notices/{noticeId} {
        allow read: if isSelf(userId);
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        allow create, delete: if false;
      }

      // Audit log of who read your data — read-only to you.
      match /audit/{entryId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      // Trainer notes about a member — the member reads their own; trainers and
      // admins read/write via functions.
      match /trainerNotes/{noteId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      // Trainer-private data (sealed with the trainer's own vault key): own read/write only.
      match /clientNotes/{noteId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly(['id', 'clientId', 'at', 'updatedAt', 'del', 'enc'])
          && request.resource.data.keys().hasAll(['id', 'clientId', 'at', 'updatedAt', 'enc'])
          && request.resource.data.id == noteId
          && request.resource.data.clientId is string && request.resource.data.clientId.size() <= 128
          && request.resource.data.at is int
          && request.resource.data.updatedAt is int
          && (!('del' in request.resource.data)
              || request.resource.data.del is bool || validDel(request.resource.data.del))
          && dekEnc(request.resource.data, 120000);
        allow delete: if isSelf(userId);
      }
      match /decisions/{decisionId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly(['id', 'clientId', 'kind', 'status', 'decidedAt', 'windowEndsAt', 'enc'])
          && request.resource.data.keys().hasAll(['id', 'clientId', 'kind', 'status', 'enc'])
          && request.resource.data.id == decisionId
          && request.resource.data.clientId is string && request.resource.data.clientId.size() <= 128
          && request.resource.data.kind is string && request.resource.data.kind.size() <= 64
          && request.resource.data.status is string && request.resource.data.status.size() <= 32
          && dekEnc(request.resource.data, 200000);
        allow delete: if isSelf(userId);
        match /evidence/{cat} {
          allow read: if isSelf(userId);
          allow create, update: if isSelf(userId)
            && request.resource.data.keys().hasOnly(['category', 'enc'])
            && request.resource.data.keys().hasAll(['category', 'enc'])
            && request.resource.data.category == cat
            && dekEnc(request.resource.data, 700000);
          allow delete: if isSelf(userId);
        }
      }
      // Client-side consent snapshots (derived views for the trainer, sealed with the client's vault key).
      match /shares/{category} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly(['category', 'level', 'asOf', 'v', 'enc'])
          && request.resource.data.keys().hasAll(['category', 'level', 'asOf', 'v', 'enc'])
          && request.resource.data.category == category
          && request.resource.data.level in ['effects', 'full']
          && request.resource.data.asOf is int
          && request.resource.data.v is int
          && dekEnc(request.resource.data, 400000);
        allow delete: if isSelf(userId);
      }
      // Consent history: written by functions only.
      match /consentLog/{entryId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
      // Legal consent records (SPO-296, append-only): written by the recordConsent function only.
      match /consentRecords/{recordId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
    }

    // --- Coaching ------------------------------------------------------------------
    // coaching/{clientId}: the relationship (trainer, mode, status, consent). Functions only.
    match /coaching/{clientId} {
      // The trainer branch ends with the relationship (status) and with the coach role (live user document).
      allow read: if isSelf(clientId)
        || (isSignedIn() && isCoachRole()
            && resource.data.trainerId == request.auth.uid
            && resource.data.get('status', '') == 'active');
      allow write: if false;
      match /summary/{docId} {
        allow read: if isSelf(clientId) || isActiveCoachOf(clientId);
        allow write: if false;
      }
    }

    // conversations/{cid}: created by functions. Everything user-written below it is sealed
    // with the conversation key (see client/src/coachCrypto). Strict key lists everywhere.
    match /conversations/{cid} {
      allow read: if inConvData(resource.data);
      allow create, delete: if false;
      allow update: if inConvData(resource.data) && (
        // the client publishes the wrapped conversation key (never the trainer)
        (request.auth.uid == resource.data.clientId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ck', 'keyEpoch'])
          && request.resource.data.keys().hasAll(['ck', 'keyEpoch'])
          && validCk(request.resource.data.ck)
          && request.resource.data.keyEpoch == request.resource.data.ck.epoch
          && ckStep(resource.data, request.resource.data.ck))
        // each side moves ONLY its own pointers
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readUpTo', 'clearedBefore'])
          && ownPointerOk('readUpTo')
          && ownMarkerOk('clearedBefore'))
      );

      match /messages/{mid} {
        allow read: if inConv(cid);
        allow create: if activeConv(cid)
          && request.resource.data.keys().hasOnly(['id', 'from', 'at', 'v', 'keyEpoch', 'enc', 'sig', 'sigKid'])
          && request.resource.data.keys().hasAll(['id', 'from', 'at', 'v', 'keyEpoch', 'enc', 'sig', 'sigKid'])
          // sender signature (C.2 no. 7) is REQUIRED: the receiver verifies it, the rules bound the size
          && request.resource.data.sig is string && request.resource.data.sig.size() <= 100
          && request.resource.data.sigKid is string && request.resource.data.sigKid.size() <= 32
          && request.resource.data.id == mid
          && request.resource.data.from == request.auth.uid
          && request.resource.data.v == 1
          && request.resource.data.at is int
          && request.resource.data.at > request.time.toMillis() - 120000
          && request.resource.data.at < request.time.toMillis() + 120000
          && sealedCk(request.resource.data)
          && epochOk(cid, request.resource.data.keyEpoch);
        allow update: if inConv(cid)
          && resource.data.from == request.auth.uid
          && !('deleted' in resource.data)
          && (
            // start the undo window / cancel it: only `del` changes, ciphertext untouched
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['del'])
              && (!('del' in request.resource.data) || validDel(request.resource.data.del)))
            // commit: the ciphertext is physically dropped, a stub stays for "Message deleted"
            || (request.resource.data.keys().hasOnly(['id', 'from', 'at', 'v', 'keyEpoch', 'deleted', 'deletedAt'])
              && request.resource.data.keys().hasAll(['id', 'from', 'at', 'v', 'keyEpoch', 'deleted', 'deletedAt'])
              && request.resource.data.deleted == true
              && request.resource.data.deletedAt is int
              && ('del' in resource.data)
              && resource.data.del.state == 'pending'
              && request.resource.data.id == resource.data.id
              && request.resource.data.from == resource.data.from
              && request.resource.data.at == resource.data.at
              && request.resource.data.v == resource.data.v
              && request.resource.data.keyEpoch == resource.data.keyEpoch)
          );
        allow delete: if false;
      }

      // Shared notes: written by the trainer only, sealed with the conversation key.
      match /notes/{nid} {
        allow read: if inConv(cid);
        allow create: if activeConv(cid) && isConvTrainer(cid)
          && request.resource.data.keys().hasOnly(['id', 'by', 'at', 'updatedAt', 'keyEpoch', 'enc', 'del'])
          && request.resource.data.keys().hasAll(['id', 'by', 'at', 'updatedAt', 'keyEpoch', 'enc'])
          && request.resource.data.id == nid
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at is int
          && request.resource.data.updatedAt is int
          && (!('del' in request.resource.data) || validDel(request.resource.data.del))
          && sealedCk(request.resource.data)
          && epochOk(cid, request.resource.data.keyEpoch);
        allow update: if activeConv(cid) && isConvTrainer(cid)
          && request.resource.data.keys().hasOnly(['id', 'by', 'at', 'updatedAt', 'keyEpoch', 'enc', 'del'])
          && request.resource.data.keys().hasAll(['id', 'by', 'at', 'updatedAt', 'keyEpoch', 'enc'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.by == resource.data.by
          && request.resource.data.at == resource.data.at
          && request.resource.data.updatedAt is int
          && (!('del' in request.resource.data) || validDel(request.resource.data.del))
          && sealedCk(request.resource.data)
          && epochOk(cid, request.resource.data.keyEpoch);
        allow delete: if activeConv(cid) && isConvTrainer(cid);
      }

      // Reschedule requests: the state machine lives in functions (`coachRescheduleCreate` /
      // `coachRescheduleRespond`, Admin SDK). The REQUESTER seals the content with the conversation key and
      // sends it through the callable, which validates the open fields only (it never holds a key): active
      // relationship, requester side, +-5 min creation window, ttl <= 14 d and ONE pending request per slotKey
      // (not expressible in rules). The other party changes only `status`/`decidedAt`, also through the callable.
      // Clients and trainers can read, never write.
      match /requests/{rid} {
        allow read: if inConv(cid) || isTeamManagerOf(convOf(cid).clientId);
        allow create, update, delete: if false;
      }

      // Delegations (SPO-196, ADR 005): the CLIENT device wraps the `schedule` and `requests` sub-keys of the CURRENT
      // epoch for one active manager of its trainer's team (same wrap shape and AAD family as `ck`). The trainer cannot
      // do this (their keys are non-extractable) and never writes here. The manager reads only their own document; the
      // client reads and deletes (a removed manager's document goes away) and nobody else touches it.
      match /delegations/{managerUid} {
        allow read: if isSelf(managerUid) && isTeamManagerOf(convOf(cid).clientId)
          || request.auth.uid == convOf(cid).clientId;
        allow create, update: if activeConv(cid)
          && request.auth.uid == convOf(cid).clientId
          && isActiveManagerIn(teamOf(convOf(cid).trainerId), managerUid)
          && request.resource.data.keys().hasOnly(['epoch', 'fp', 'schedule', 'requests', 'at'])
          && request.resource.data.keys().hasAll(['epoch', 'fp', 'schedule', 'requests', 'at'])
          && request.resource.data.epoch is int
          && request.resource.data.epoch == convOf(cid).get('keyEpoch', 0)
          && request.resource.data.fp is string && request.resource.data.fp.size() == 16
          && request.resource.data.at is int
          && validCk(request.resource.data.schedule)
          && validCk(request.resource.data.requests)
          && request.resource.data.schedule.epoch == request.resource.data.epoch
          && request.resource.data.requests.epoch == request.resource.data.epoch
          && request.resource.data.schedule.fp == request.resource.data.fp
          && request.resource.data.requests.fp == request.resource.data.fp;
        allow delete: if request.auth.uid == convOf(cid).clientId;
      }

      // Key ring of PAST epochs (plan-security C.2): the CLIENT device wraps each earlier epoch of the current link
      // period for the trainer's signed key, so the trainer keeps the history they legitimately held after a rotation.
      // Same wrap shape and AAD as `conversations/{cid}.ck`. Only the client writes (active relationship, strictly an
      // epoch below the published one); both active parties read; nobody deletes (the end function removes the whole
      // ring, so a removed trainer who is linked again holds nothing of the earlier period).
      match /keyring/{epoch} {
        allow read: if inConv(cid);
        allow create, update: if activeConv(cid)
          && request.auth.uid == convOf(cid).clientId
          && request.resource.data.keys().hasOnly(['epoch', 'ck', 'at'])
          && request.resource.data.keys().hasAll(['epoch', 'ck', 'at'])
          && request.resource.data.epoch is int
          && request.resource.data.epoch == int(epoch)
          && epoch == string(request.resource.data.epoch)
          && request.resource.data.at is int
          && validCk(request.resource.data.ck)
          && request.resource.data.ck.epoch == request.resource.data.epoch
          && request.resource.data.epoch < convOf(cid).get('keyEpoch', 0);
        allow delete: if false;
      }
    }

    // Weekly schedule, sealed with the conversation key. The trainer writes while active; a team manager of that
    // trainer may read and write it too (SPO-196): they only hold the delegated `schedule` sub-key (ADR 005), `trainerId`
    // always stays the client's trainer, never the manager.
    function scheduleWriter(clientId, d) {
      return (isActiveCoachOf(clientId) && d.trainerId == request.auth.uid)
        || (isTeamManagerOf(clientId) && d.trainerId == coachingOf(clientId).trainerId);
    }
    // `timing` is the only open part: moments (epoch ms) for the server's reminders, never what the session is (SPO-265).
    function validTiming(t) {
      return t == null || (t is map
        && t.keys().hasOnly(['starts', 'unmarked', 'dueAt'])
        && t.starts is list && t.starts.size() <= 12
        && t.unmarked is list && t.unmarked.size() <= 12
        && t.dueAt is int);
    }
    match /schedules/{clientId} {
      allow read: if isSelf(clientId) || isActiveCoachOf(clientId) || isTeamManagerOf(clientId);
      allow create: if request.resource.data.keys().hasOnly(['clientId', 'trainerId', 'rev', 'updatedAt', 'keyEpoch', 'enc', 'timing'])
        && request.resource.data.keys().hasAll(['clientId', 'trainerId', 'rev', 'updatedAt', 'keyEpoch', 'enc'])
        && request.resource.data.clientId == clientId
        && scheduleWriter(clientId, request.resource.data)
        && request.resource.data.updatedAt is int
        && request.resource.data.rev == 1
        && validTiming(request.resource.data.get('timing', null))
        && sealedCkSchedule(request.resource.data);
      allow update: if request.resource.data.keys().hasOnly(['clientId', 'trainerId', 'rev', 'updatedAt', 'keyEpoch', 'enc', 'timing'])
        && request.resource.data.keys().hasAll(['clientId', 'trainerId', 'rev', 'updatedAt', 'keyEpoch', 'enc'])
        && request.resource.data.clientId == clientId
        && scheduleWriter(clientId, request.resource.data)
        && request.resource.data.updatedAt is int
        && request.resource.data.rev == resource.data.rev + 1
        && validTiming(request.resource.data.get('timing', null))
        && sealedCkSchedule(request.resource.data);
      allow delete: if false;
    }

    // Per-client program overlay. `liveVersion` moves only through publishPlanVersion (functions).
    match /plans/{clientId} {
      allow read: if isSelf(clientId) || isActiveCoachOf(clientId);
      allow create: if isActiveCoachOf(clientId)
        && request.resource.data.keys().hasOnly(['clientId', 'trainerId', 'programId', 'liveVersion', 'rev', 'updatedAt', 'keyEpoch', 'enc'])
        && request.resource.data.keys().hasAll(['clientId', 'trainerId', 'programId', 'rev', 'updatedAt', 'keyEpoch', 'enc'])
        && request.resource.data.clientId == clientId
        && request.resource.data.trainerId == request.auth.uid
        && request.resource.data.programId is string
        && request.resource.data.get('liveVersion', 0) == 0
        && request.resource.data.updatedAt is int
        && request.resource.data.rev == 1
        && sealedCkPlan(request.resource.data);
      allow update: if isActiveCoachOf(clientId)
        && request.resource.data.keys().hasOnly(['clientId', 'trainerId', 'programId', 'liveVersion', 'rev', 'updatedAt', 'keyEpoch', 'enc'])
        && request.resource.data.keys().hasAll(['clientId', 'trainerId', 'programId', 'rev', 'updatedAt', 'keyEpoch', 'enc'])
        && request.resource.data.clientId == clientId
        && request.resource.data.trainerId == request.auth.uid
        && request.resource.data.programId is string
        && request.resource.data.get('liveVersion', 0) == resource.data.get('liveVersion', 0)
        && request.resource.data.updatedAt is int
        && request.resource.data.rev == resource.data.rev + 1
        && sealedCkPlan(request.resource.data);
      allow delete: if false;

      match /versions/{n} {
        allow read: if isActiveCoachOf(clientId)
          || (isSelf(clientId) && resource.data.state != 'draft');
        allow create: if isActiveCoachOf(clientId)
          && request.resource.data.keys().hasOnly(['n', 'programId', 'state', 'createdAt', 'publishedAt', 'keyEpoch', 'enc'])
          && request.resource.data.keys().hasAll(['n', 'programId', 'state', 'createdAt', 'keyEpoch', 'enc'])
          && request.resource.data.n == int(n)
          && request.resource.data.state == 'draft'
          && request.resource.data.createdAt is int
          && sealedCkPlan(request.resource.data);
        allow update: if isActiveCoachOf(clientId)
          && resource.data.state == 'draft'
          && request.resource.data.state == 'draft'
          && request.resource.data.keys().hasOnly(['n', 'programId', 'state', 'createdAt', 'publishedAt', 'keyEpoch', 'enc'])
          && request.resource.data.keys().hasAll(['n', 'programId', 'state', 'createdAt', 'keyEpoch', 'enc'])
          && request.resource.data.n == resource.data.n
          && request.resource.data.createdAt == resource.data.createdAt
          && sealedCkPlan(request.resource.data);
        allow delete: if isActiveCoachOf(clientId) && resource.data.state == 'draft';
      }
    }

    // --- Coached-athlete live sessions -------------------------------------
    // One doc per athlete (id = their uid), written by the athlete, read by
    // their coach. The coach's Today queries by trainerId; the read rule scopes
    // it to their own athletes. Writes are strictly active-session presence
    // only: no exercises, sets, loads, notes or other workout details.
    match /liveSessions/{athleteId} {
      allow read: if isSelf(athleteId)
        || (isSignedIn() && resource.data.trainerId == request.auth.uid);
      allow create, update: if isSelf(athleteId) && validLiveSession(athleteId);
      allow delete: if isSelf(athleteId);
    }

    // --- Sleep auto-start queue --------------------------------------------
    // One doc per user: the upcoming bedtimes (as absolute instants the client
    // computed in its timezone) that the auto-start function consumes. Owner
    // read/write; the function reads/updates it with the Admin SDK.
    match /sleepSchedules/{userId} {
      allow read, write: if isSelf(userId);
    }

    // Coach PUBLIC keys for the vault key exchange. Anyone signed in may read one (an
    // athlete needs it to create a grant); only its owner writes it, and only a public JWK.
    match /coachKeys/{userId} {
      allow read: if isSignedIn();
      // `sig`, `kid`, `signedAt` are written by the `coachKeySignCall` function (Admin SDK) and bind uid, key
      // fingerprint and `updatedAt`. The owner may keep them untouched (e.g. a merge write) but never set or change
      // them; a new `pub` without a fresh signature is simply refused by clients (key pinning, plan-security C.2 no. 5).
      allow create, update: if isSelf(userId) && (isCoachRole() || isManager())
        && request.resource.data.keys().hasOnly(['pub', 'updatedAt', 'sig', 'kid', 'signedAt'])
        && request.resource.data.keys().hasAll(['pub', 'updatedAt'])
        && request.resource.data.pub is map
        && request.resource.data.pub.keys().hasOnly(['kty', 'crv', 'x', 'y', 'ext', 'key_ops'])
        && request.resource.data.pub.get('kty', '') == 'EC'
        && request.resource.data.pub.get('crv', '') == 'P-256'
        && request.resource.data.pub.get('x', 0) is string && request.resource.data.pub.x.size() <= 64
        && request.resource.data.pub.get('y', 0) is string && request.resource.data.pub.y.size() <= 64
        && request.resource.data.updatedAt is int
        // a signature may only be carried over UNCHANGED together with the very same key it was made for
        && (!('sig' in request.resource.data)
            || (resource != null
                && request.resource.data.pub == resource.data.pub
                && request.resource.data.get('sig', null) == resource.data.get('sig', null)
                && request.resource.data.get('kid', null) == resource.data.get('kid', null)
                && request.resource.data.get('signedAt', null) == resource.data.get('signedAt', null)));
      allow delete: if false;
    }

    // Device signing keys (public halves) for chat sender authenticity (plan-security C.2 no. 7). Written by
    // `coachPublishSignKey` under a server signature only; any signed-in user may read a counterpart's key.
    match /signKeys/{userId}/keys/{kid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Credentials & uniqueness indexes: functions only -------------------
    match /credentials/{userId} {
      allow read, write: if false;
    }
    match /usernames/{usernameLower} {
      allow read, write: if false;
    }
    match /invites/{token} {
      allow read, write: if false;
    }

    // --- Shared exercise catalog -------------------------------------------
    // App-wide switches edited by the owner in the console (read-only here).
    // config/atlas: { chatUsers: [username…], chatUids: [uid…] } — who may
    // use Atlas's free-form Gemini chat while it is in closed testing.
    // config/flags: global feature flags (e.g. brassGlass) — every signed-in
    // user reads them, only admins flip them from app Settings.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if docId == 'flags' && isAdmin();
    }
    match /exerciseCatalog/{entryId} {
      allow read: if isSignedIn();
      allow create, update: if isTrainerOrAdmin();
      allow delete: if isAdmin();
    }

    // --- Shared gyms: crowdsourced equipment inventory ----------------------
    // A gym is a shared entity keyed by its stable venue id (externalId). Its
    // equipment inventory is contributed by any signed-in user, like a map
    // amenity — clients write deltas (arrayUnion/arrayRemove). No personal data
    // lives here (just a list of catalog equipment ids + updatedAt).
    match /sharedGyms/{gymKey} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- Programs -----------------------------------------------------------
    // Items are embedded in the program document (an array), like workouts.
    match /programs/{programId} {
      allow read: if isSignedIn() && (
        resource.data.authorId == uid()
        || (
          exists(/databases/$(database)/documents/assignments/$(uid()))
          && get(/databases/$(database)/documents/assignments/$(uid())).data.programId == programId
        )
      );
      allow create: if isSignedIn() && request.resource.data.authorId == uid() && prgOk(programId);
      allow update: if isSignedIn()
        && resource.data.authorId == uid()
        && request.resource.data.authorId == uid()
        && prgOk(programId);
      allow delete: if isSignedIn() && resource.data.authorId == uid() && prgOk(programId);
    }

    // --- Teams (SPO-196) ------------------------------------------------------------------------
    // teams/{teamId}: teamId = the owner trainer's uid. EVERYTHING is written by functions (Admin SDK). Reads:
    //  - the team document and member list: the owner, active members, and the owner's active clients (a client must
    //    know which managers exist to delegate keys; members hold no health data, only role/status/name/fp);
    //  - `acl/{uid}` (activityScope): the owner and that member only;
    //  - `activity/*` (metadata only, no encrypted content): the owner reads all; a member reads own entries, or all
    //    when the owner has set activityScope == 'all' for them.
    function clientOfTeam(teamId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/coaching/$(request.auth.uid))
        && coachingOf(request.auth.uid).get('status', '') == 'active'
        && teamOf(coachingOf(request.auth.uid).trainerId) == teamId;
    }
    match /teams/{teamId} {
      allow read: if isSelf(teamId) || isActiveMemberOf(teamId);
      allow write: if false;
      match /members/{memberUid} {
        allow read: if isSelf(teamId) || isSelf(memberUid) || isActiveMemberOf(teamId) || clientOfTeam(teamId);
        allow write: if false;
      }
      match /acl/{memberUid} {
        allow read: if isSelf(teamId) || isSelf(memberUid);
        allow write: if false;
      }
      match /activity/{entryId} {
        allow read: if isSelf(teamId)
          || (isActiveMemberOf(teamId)
              && (resource.data.actorUid == request.auth.uid
                  || (exists(/databases/$(database)/documents/teams/$(teamId)/acl/$(request.auth.uid))
                      && get(/databases/$(database)/documents/teams/$(teamId)/acl/$(request.auth.uid)).data.get('activityScope', 'own') == 'all')));
        allow write: if false;
      }
    }
    // Invites and client-removal requests: functions write; the parties read their own.
    match /teamInvites/{inviteId} {
      allow read: if isSignedIn() && (resource.data.get('invitedBy', '') == request.auth.uid
        || resource.data.get('teamId', '') == request.auth.uid);
      allow write: if false;
    }
    match /teamRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.get('requestedBy', '') == request.auth.uid
        || resource.data.get('trainerId', '') == request.auth.uid);
      allow write: if false;
    }

    // Program assignments: readable by the member and by trainers/admins;
    // written only by functions (single-active invariant + notice fan-out).
    match /assignments/{memberId} {
      allow read: if isSelf(memberId) || isTrainerOrAdmin();
      allow write: if false;
    }

    // Anything not matched above is denied by default.
  }
}
