{
  "name": "spotter-functions",
  "description": "Spotter privileged backend (Cloud Functions)",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@ip-location-db/dbip-city-mmdb": "^2.3.2026060513",
    "@simplewebauthn/server": "^13.3.3",
    "bcryptjs": "^3.0.2",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "mmdb-lib": "^3.0.4"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
