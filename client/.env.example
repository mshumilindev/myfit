# Optional place-provider keys for gym search (client/.env.local).
# Copy this file to `client/.env.local` and fill in the keys you have.
# Leave a key blank/absent → that provider stays "skipped" (app still works
# via OpenStreetMap). Restart `npm run dev` after changing.
#
# Google Places (New) — real photos + best coverage.
#   console.cloud.google.com → enable "Places API (New)" → Credentials →
#   create API key → restrict it to "Places API (New)" + your HTTP referrers.
VITE_GOOGLE_PLACES_KEY=

# Foursquare Places — extra coverage (no photos wired).
#   foursquare.com/developers → create project → Service API key.
VITE_FOURSQUARE_KEY=

# Web push (Firebase console → Project settings → Cloud Messaging → Web Push certificates → public key).
# Without it push stays off and the rest timer falls back to local alerts.
VITE_FCM_VAPID_KEY=...

# Atlas chat (Firebase AI Logic → Gemini Developer API). App Check site key
# (reCAPTCHA Enterprise). Without it chat still works unless AI Logic enforces App Check.
VITE_RECAPTCHA_ENTERPRISE_KEY=...
# Dev only: App Check debug token registered in the Firebase console (without it dev skips App Check).
VITE_APPCHECK_DEBUG_TOKEN=
# Optional: override the chat model id (default gemini-3.5-flash-lite).
# VITE_ATLAS_MODEL=gemini-3.5-flash-lite

# --- Coach (trainer dashboard + "My trainer") -----------------------------------------------------------------------
# Where Coach gets its data. Build-time (Vite) variable. There is NO demo / sample data in the app (any build):
#   (unset)     the REAL backend. In `npm run dev` a bounded probe of one callable decides first; when the backend is not deployed
#               (or offline / denied / too slow) Coach shows an error state with the reason and "Try again".
#   firestore   the same, without the probe. Needs the deploy checklist of docs/COACH-BACKEND.md (rules, indexes, functions, secrets).
#   off         Coach renders no clients ("not configured").
# Sample data exists only as test doubles (`src/coach/**/__fixtures__`) for Vitest, Storybook and the QA screenshot build
# (`vite.config.qa.ts`, never shipped).
VITE_COACH_BACKEND=
# Public origin the invite links point at (`<origin>/#/invite/<token>`). Default: the Firebase hosting origin
# (https://spotter-64c3b.web.app) in production builds, the current origin in dev.
VITE_APP_ORIGIN=
