# Copy to .env (gitignored) and fill in locally. Never commit real keys.

# --- Exercise image pipeline (scripts/exercise-images, dev-only) ---
# comfyui = free local generation on this Mac (see docs, local/setup-mac.sh)
# openai  = paid API · mock = offline plumbing test
IMAGE_PROVIDER=comfyui
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=high
# IMAGE_SIZE defaults: 1536x1024 (openai) / 1248x832 (comfyui)
IMAGE_OUTPUT_SIZE=960x640
IMAGE_OUTPUT_FORMAT=webp
IMAGE_OUTPUT_QUALITY=80
# 1 = one exercise at a time, so athlete drift is visible immediately
IMAGE_GENERATION_CONCURRENCY=1
IMAGE_GENERATION_RETRIES=3
# IMAGE_GENERATION_TIMEOUT_MS defaults: 180000 (openai) / 900000 (comfyui)
IMAGE_MAX_QA_ATTEMPTS=2
IMAGE_QA_ENABLED=true
# auto = ollama for comfyui, openai for openai
IMAGE_QA_PROVIDER=auto
# IMAGE_QA_MODEL defaults: qwen2.5vl:7b (ollama) / gpt-4.1 (openai)
IMAGE_QA_MIN_SCORE=8
# Jobs with more images than this refuse to run without --confirm-bulk
IMAGE_BULK_THRESHOLD=24
IMAGE_STATES=start,end
IMAGE_KEEP_SOURCE=true

# --- Local generation (IMAGE_PROVIDER=comfyui) ---
COMFYUI_URL=http://127.0.0.1:8188
# qwen-edit-2511 = best quality (Apache-2.0) · flux2-klein-4b = fast fallback
COMFYUI_PRESET=qwen-edit-2511
# COMFYUI_LORA=none        # full-step sampling: slower, a bit better
# COMFYUI_STEPS= / COMFYUI_CFG= / COMFYUI_UNET= / COMFYUI_CLIP= / COMFYUI_VAE=
COMFYUI_FREE_BEFORE_QA=true
OLLAMA_URL=http://127.0.0.1:11434
